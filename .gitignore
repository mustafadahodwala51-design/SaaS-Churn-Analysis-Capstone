# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# --- Jupyter ----------------------------------------------------------------
.ipynb_checkpoints/
# The committed notebook is written by build_notebook.py and executed separately,
# so a stray checkpoint directory from a local session is noise.
*.nbconvert.ipynb
profile_default/
ipython_config.py

# --- Editors and OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

--- Excel -------------------------------------------------------------------
# The workbook is a generated deliverable produced by python/build_excel.py.
~$*.xlsx
*.tmp
~$*

# --- Generated data ---------------------------------------------------------
# data/raw/ IS committed: the raw CSVs are the reproducible input to the
# project and reviewers should be able to see the defects without running
# anything. The cleaned tables, charts, workbook and reports are also committed
# so the repository can be read without executing code.
#
# Only genuinely transient files are ignored below.
*.log
*.bak
*.swp
